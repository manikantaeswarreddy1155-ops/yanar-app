# YANAR Environment Variables

# Backend API URL (for local development or live cloud deployment on Render, Railway, etc.)
VITE_API_URL=http://127.0.0.1:5000

# Optional: Dedicated WebSocket URL (automatically infers ws:// or wss:// from VITE_API_URL if omitted)
# VITE_WS_URL=ws://127.0.0.1:5000

# Optional: Free-tier Supabase credentials
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
